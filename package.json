{
  "name": "pi-coffee-server",
  "version": "0.57.0",
  "private": true,
  "description": "PI Coffee: Browser, Web gateway and native Agent Host",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-runtime.mjs && node scripts/build-vendor.mjs && node scripts/copy-public.mjs",
    "test": "vitest run",
    "check": "node scripts/check.mjs",
    "start": "node dist/src/main.js all",
    "start:host": "node dist/src/main.js host",
    "probe:owner-access": "npm run build && node scripts/probe-owner-access.mjs",
    "smoke:gitea-workspaces": "npm run build && node scripts/smoke-gitea-workspaces.mjs",
    "start:web": "node dist/src/main.js web",
    "start:relay": "node dist/src/main.js relay",
    "lint": "eslint public scripts eslint.config.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "verify": "node scripts/verify.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "check:release": "node scripts/verify.mjs --require-review .coffee-verification/review.json",
    "verify:fresh": "node scripts/verify-fresh.mjs",
    "test:tools": "vitest run test/developer-verification.test.ts test/developer-lint.test.ts test/developer-publish.test.ts test/developer-release.test.ts test/developer-fresh.test.ts test/release-status-http.test.ts",
    "test:sidebar": "vitest run test/shell-logic.test.ts test/local-first-app.test.ts test/sidebar-interaction.test.ts test/sidebar-http.test.ts test/native-agents.test.ts",
    "version:release": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "context-handoff": "http://gitea:3000/awangs/pi-coffee/releases/download/candidates%2Fpi-1.4.0-dcbcc743/context-handoff-0.2.0-experimental.7.tgz",
    "pi-antigravity": "0.11.0",
    "pi-coffee-harness": "http://gitea:3000/awangs/pi-coffee/releases/download/candidates%2Fpi-1.4.0-dcbcc743/pi-coffee-harness-0.3.4.tgz",
    "pi-coffee-lsp": "http://gitea:3000/awangs/pi-coffee/releases/download/candidates%2Fpi-1.4.0-dcbcc743/pi-coffee-lsp-0.4.8.tgz",
    "pi-coffee-mishu": "http://gitea:3000/awangs/pi-coffee-mishu/releases/download/candidates%2Fpi-1.4.0-08fbd13/pi-coffee-mishu-0.4.0-experience.2.tgz",
    "pi-subagents": "0.81.0",
    "pi-web-access": "0.44.0",
    "pi-xai-oauth": "1.7.3",
    "typebox": "1.3.36",
    "ws": "8.21.3",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@pierre/diffs": "1.5.1",
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "^30.1.0",
    "marked": "^18.0.11",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "undici": "8.12.3",
    "vite": "8.3.3"
  }
}
