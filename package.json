{
  "name": "pi-coffee",
  "version": "0.1.0",
  "private": true,
  "description": "PI Coffee MVP: a thin web host for the original Pi coding agent",
  "type": "module",
  "pi": {
    "extensions": [
      "./dist/src/web/extension.js",
      "./dist/src/harness/extension.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-public.mjs",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "start": "node dist/src/main.js all",
    "start:host": "node dist/src/main.js host",
    "start:web": "node dist/src/main.js web",
    "start:relay": "node dist/src/main.js relay",
    "smoke:subagents": "npm run build && node scripts/smoke-subagents.mjs",
    "smoke:web": "npm run build && node scripts/smoke-web.mjs",
    "smoke:workspace-browser": "npm run build && node scripts/smoke-workspace-browser.mjs",
    "smoke:gitea-oauth": "npm run build && node scripts/smoke-gitea-oauth.mjs",
    "preview:workspace": "npm run build && node scripts/preview-workspace.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@juicesharp/rpiv-todo": "2.9.0",
    "context-fold": "0.4.0",
    "jiti": "2.7.0",
    "pi-lens": "4.1.3",
    "pi-mcp-adapter": "2.32.1",
    "pi-subagents": "0.63.0",
    "pi-web-access": "0.27.0",
    "typebox": "1.3.7",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
