{
  "name": "pi-coffee-server",
  "version": "0.1.0",
  "private": true,
  "description": "PI Coffee: Browser, Web gateway and native Agent Host",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-runtime.mjs && node scripts/build-vendor.mjs && node scripts/copy-public.mjs",
    "test": "vitest run",
    "check": "node scripts/check.mjs",
    "start": "node dist/src/main.js all",
    "start:host": "node dist/src/main.js host",
    "probe:owner-access": "npm run build && node scripts/probe-owner-access.mjs",
    "smoke:gitea-workspaces": "npm run build && node scripts/smoke-gitea-workspaces.mjs",
    "start:web": "node dist/src/main.js web",
    "start:relay": "node dist/src/main.js relay"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "context-handoff": "https://github.com/awangs1986/pi-coffee/releases/download/context-handoff%2Fv0.2.0-experimental.4/context-handoff-0.2.0-experimental.4.tgz",
    "pi-antigravity": "0.9.0",
    "pi-coffee-harness": "https://github.com/awangs1986/pi-coffee/releases/download/harness%2Fv0.3.0/pi-coffee-harness-0.3.0.tgz",
    "pi-coffee-lsp": "https://github.com/awangs1986/pi-coffee/releases/download/lsp%2Fv0.4.5/pi-coffee-lsp-0.4.5.tgz",
    "pi-subagents": "https://codeload.github.com/nicobailon/pi-subagents/tar.gz/10694a673cb077b4d3ec6a6cfe68acb6c28b83a5",
    "pi-web-access": "0.35.0",
    "typebox": "1.3.34",
    "ws": "8.21.3",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@pierre/diffs": "1.5.1",
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "dompurify": "^3.4.14",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.1.0",
    "marked": "^18.0.11",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "undici": "8.11.2"
  }
}
