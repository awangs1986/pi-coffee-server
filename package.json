{
  "name": "pi-coffee-server",
  "version": "0.1.0",
  "private": true,
  "description": "PI Coffee: Browser, Web gateway and native Agent Host",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-runtime.mjs && node scripts/build-vendor.mjs && node scripts/copy-public.mjs",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "start": "node dist/src/main.js all",
    "start:host": "node dist/src/main.js host",
    "probe:owner-access": "npm run build && node scripts/probe-owner-access.mjs",
    "smoke:gitea-workspaces": "npm run build && node scripts/smoke-gitea-workspaces.mjs",
    "start:web": "node dist/src/main.js web",
    "start:relay": "node dist/src/main.js relay"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "context-handoff": "github:awangs1986/pi-context-handoff#ce7a6d07b215473da3b2703d9c2a6b83dbb5e162",
    "pi-coffee": "git+https://github.com/awangs1986/pi-coffee.git#1ec49a93048f0e441806cd17da7b245972e5f51a",
    "pi-coffee-harness": "github:awangs1986/pi-coffee-harness#d068251dc1b4de59c4178eb04e0d4a0fcc117187",
    "typebox": "1.3.7",
    "ws": "8.21.3",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@pierre/diffs": "1.5.1",
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "dompurify": "^3.4.14",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.0",
    "marked": "^18.0.11",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
