{
  "name": "pi-coffee-server",
  "version": "0.1.0",
  "private": true,
  "description": "PI Coffee: Browser, Web gateway and native Agent Host",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-runtime.mjs && node scripts/build-vendor.mjs && node scripts/copy-public.mjs",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "start": "node dist/src/main.js all",
    "start:host": "node dist/src/main.js host",
    "probe:owner-access": "npm run build && node scripts/probe-owner-access.mjs",
    "smoke:gitea-workspaces": "npm run build && node scripts/smoke-gitea-workspaces.mjs",
    "start:web": "node dist/src/main.js web",
    "start:relay": "node dist/src/main.js relay"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "context-handoff": "https://github.com/awangs1986/pi-coffee/releases/download/context-handoff%2Fv0.2.0-experimental.3/context-handoff-0.2.0-experimental.3.tgz",
    "pi-coffee-harness": "file:vendor/pi-coffee-harness-0.2.0-rc.1.tgz",
    "typebox": "1.3.27",
    "ws": "8.21.3",
    "yaml": "2.8.3",
    "pi-coffee-lsp": "https://github.com/awangs1986/pi-coffee/releases/download/lsp%2Fv0.4.4/pi-coffee-lsp-0.4.4.tgz",
    "pi-subagents": "0.73.1",
    "pi-web-access": "0.34.0"
  },
  "devDependencies": {
    "@pierre/diffs": "1.5.1",
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "dompurify": "^3.4.14",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.0",
    "marked": "^18.0.11",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "undici": "8.11.2"
  }
}
