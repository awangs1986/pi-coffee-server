# /etc/pi-coffee/host.env  (chmod 0600, readable by the VM owner user)
# The Host holds NO upstream LLM key. Pi reaches the model through the Relay.

# Bind the private Host transport. The Web VM must reach this address; nothing else should.
PI_COFFEE_HOST_BIND=0.0.0.0
PI_COFFEE_HOST_PORT=8788
# Mandatory when not bound to loopback (the Host refuses to start otherwise).
# Must equal PI_COFFEE_HOST_TOKEN in the server's web.env.
PI_COFFEE_HOST_TOKEN=REPLACE_WITH_SHARED_HOST_TOKEN

# This VM's Relay token: one of the entries in the server's PI_COFFEE_RELAY_TOKENS.
# It is interpolated by Pi from models.json ("apiKey": "$PI_COFFEE_RELAY_TOKEN").
PI_COFFEE_RELAY_TOKEN=REPLACE_WITH_THIS_VMS_RELAY_TOKEN

# Where Pi works and keeps its native sessions. Owned by the VM owner.
# One VM serves every Gitea user (ADR-0010): user "alice" gets
#   <WORKDIR>/alice            (Pi cwd, uploads under .pi-coffee/inbox/, research under .pi-coffee/research/)
#   <SESSION_DIR>/alice        (her conversations; the other user's sidebar never lists them)
# The agent dir (models.json, the single enterprise model login) is shared.
PI_COFFEE_WORKDIR=/home/REPLACE_WITH_VM_OWNER/work
# Multi-user deployment: never accept a connection that carries no user name
# (a misconfigured Web Server must not reach the shared root scope).
PI_COFFEE_REQUIRE_USER=1
PI_COFFEE_AGENT_DIR=/home/REPLACE_WITH_VM_OWNER/.pi-coffee/agent
PI_COFFEE_SESSION_DIR=/home/REPLACE_WITH_VM_OWNER/.pi-coffee/sessions

# The bundled V5 Harness and locked pi-subagents extension are loaded by
# default. Set PI_COFFEE_SUBAGENTS=off to disable only delegation. For a
# transport-only diagnostic, set PI_COFFEE_EXTENSIONS=off; otherwise that
# variable is a colon-separated replacement list of explicit extension paths.
# PI_COFFEE_SUBAGENTS=off
# PI_COFFEE_EXTENSIONS=off

# File transfer (ADR-0009): LocalSend v2 over plain HTTP, reached directly by
# browsers on the user network. When unset, the Host defaults to 127.0.0.1.
# Set a LAN bind (0.0.0.0 or the advertise IP) and open 53317 for direct clients.
# Set "off" to disable.
PI_COFFEE_TRANSFER_BIND=0.0.0.0
PI_COFFEE_TRANSFER_PORT=53317
# Address browsers should use; auto-detected first LAN IPv4 when omitted.
# PI_COFFEE_TRANSFER_ADVERTISE=192.168.1.50
# PI_COFFEE_MAX_FILE_BYTES=268435456     # 256 MiB per file
# PI_COFFEE_MAX_BATCH_BYTES=1073741824   # 1 GiB per batch
# Optional HTTPS route (internal CA; must be paired with the Web Server's TLS):
# PI_COFFEE_TRANSFER_TLS_CERT=/etc/pi-coffee/tls/vm.crt
# PI_COFFEE_TRANSFER_TLS_KEY=/etc/pi-coffee/tls/vm.key

# Optional: GitHub repositories as Work Projects (ADR-0022), beside Gitea.
# The token is used only by the Host for the GitHub REST API (list repositories,
# check push permission, open/reuse pull requests). It never reaches the browser
# and is removed from Agent processes. PRs are authored by the token's account for
# every user. Clone/fetch/push use the VM owner's own Git credentials, so also run
# e.g. `gh auth setup-git` (or configure an SSH key) as the VM owner.
# Fine-grained token: Contents read/write, Pull requests read/write, Metadata read.
# PI_COFFEE_GITHUB_TOKEN=REPLACE_WITH_GITHUB_TOKEN
# GitHub Enterprise Server only:
# PI_COFFEE_GITHUB_API_URL=https://ghe.example/api/v3

# Provider/model names as defined in $PI_COFFEE_AGENT_DIR/models.json
PI_COFFEE_PROVIDER=cpa
PI_COFFEE_MODEL=gpt-5.4-mini

# Agent CLI (ADR-0011). Default "pi". With "codex" the Host runs one
# `codex app-server` per user (cwd <WORKDIR>/<user>) against the ONE Codex
# login the VM admin made (`codex login`, or an API key) in CODEX_HOME. Both
# users' sessions run concurrently on that login; the Relay is not used.
# PI_COFFEE_AGENT=codex
# PI_COFFEE_CODEX_BIN=/usr/local/bin/codex
# PI_COFFEE_CODEX_HOME=/home/REPLACE_WITH_VM_OWNER/.codex
# PI_COFFEE_MODEL=gpt-5-codex            # Codex model id when PI_COFFEE_AGENT=codex
# PI_COFFEE_CODEX_EFFORT=medium
# PI_COFFEE_CODEX_SANDBOX=workspace-write      # read-only | workspace-write | danger-full-access
# PI_COFFEE_CODEX_APPROVAL=on-request          # never | on-request | untrusted (dialogs in the browser)
# PI_COFFEE_CODEX_ARGS=-c:model_provider=openai

# Optional: replay buffer per session (in-flight events kept for reconnect catch-up)
# PI_COFFEE_EVENT_BUFFER=256
# Optional: stop a Pi process (or a user's codex app-server once all of their
# sessions are closed) with no browser attached and nothing running after this
# long. Conversations stay in the session store and resume on next open.
# PI_COFFEE_IDLE_TIMEOUT_MS=600000

# GitHub: production uses Web-bound per-user accounts; PI_COFFEE_GITHUB_TOKEN is legacy.
# Model login remains native. Do not configure a global GitHub token for task authorization.
