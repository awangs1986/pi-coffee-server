# /etc/pi-coffee/web.env  (chmod 0600)
# Web holds Gitea app credentials and fixed per-user Host routes, not model credentials or durable chat bodies.

# Browser-facing bind. LAN HTTP is accepted for this first release; optional HTTPS remains available.
PI_COFFEE_WEB_BIND=0.0.0.0
PI_COFFEE_WEB_PORT=3000

# Optional legacy single-user configuration only; identity mode uses routes.json instead.
# PI_COFFEE_HOST_URL=ws://USER_VM_IP:8788/host
# Must equal PI_COFFEE_HOST_TOKEN in that User VM's host.env. Generate: openssl rand -hex 32
# PI_COFFEE_HOST_TOKEN=REPLACE_WITH_SHARED_HOST_TOKEN

# Optional HTTPS route (internal CA). If set, every User VM's transfer port must
# also have TLS, or browsers block the uploads as mixed content. See runbook.
# PI_COFFEE_WEB_TLS_CERT=/etc/pi-coffee/tls/web.crt
# PI_COFFEE_WEB_TLS_KEY=/etc/pi-coffee/tls/web.key

# Multi-user identity (required for public binding; do not enable unauthenticated demo mode).
PI_COFFEE_GITEA_URL=http://GITEA_HOST:3000
PI_COFFEE_GITEA_CLIENT_ID=REPLACE
PI_COFFEE_GITEA_CLIENT_SECRET=REPLACE
PI_COFFEE_PUBLIC_URL=http://WEB_HOST:3000
PI_COFFEE_ROUTES_FILE=/etc/pi-coffee/routes.json
# routes.json: numeric Gitea user ID -> {hostUrl, hostToken}; distinct VM and token per user.
# See docs/development/p0-p4-implementation-20260916.md for the configuration and remaining gates.

# Optional per-user GitHub account binding (OAuth App; keep the secret private).
# Register callback: <PI_COFFEE_PUBLIC_URL>/auth/github/callback
PI_COFFEE_GITHUB_CLIENT_ID=
PI_COFFEE_GITHUB_CLIENT_SECRET=
